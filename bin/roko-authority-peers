#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from authority_peers import AuthorityPeerError, main

try:
    raise SystemExit(main())
except AuthorityPeerError as error:
    print(f"roko-authority-peers: {error}", file=sys.stderr)
    raise SystemExit(1)
