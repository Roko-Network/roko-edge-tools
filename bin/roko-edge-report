#!/usr/bin/env bash
set -euo pipefail

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${1:-roko-edge-report-$(date -u +%Y%m%dT%H%M%SZ).txt}"

{
  echo "ROKO edge report"
  echo "generated_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo
  "$TOOL_DIR/bin/roko-edge-doctor" 2>&1 || true
} |
  sed -E \
    -e 's/(Authorization: Bearer )[A-Za-z0-9._~+/-]+/\\1[REDACTED]/g' \
    -e 's/(token=)[A-Za-z0-9._~+/-]+/\\1[REDACTED]/g' \
    -e 's/(secret(_id)?=)[A-Za-z0-9._~+/-]+/\\1[REDACTED]/gi' \
    > "$OUT"

echo "wrote $OUT"
