{
  "$schema": "https://aiwg.io/schemas/aiwg.config.v1.json",
  "version": "1",
  "providers": [
    "claude"
  ],
  "installed": {},
  "scripts": {
    "deploy": "aiwg use all",
    "doctor": "aiwg doctor",
    "sync": "aiwg sync"
  },
  "security": {
    "threatAssessment": {
      "schemaVersion": "1",
      "mode": "enforce",
      "defaultProfile": "balanced"
    }
  },
  "artifact_outputs": {
    "canonical": "aiwg",
    "provider_native": "explicit-only",
    "destinations": {}
  },
  "delivery": {
    "mode": "direct",
    "default_branch": "main",
    "require_ci_green": true,
    "auto_close_issues": true,
    "issue_comment_on_cycle": true,
    "force_push_policy": "never"
  },
  "parallelism": {
    "max_parallel_subagents": 4,
    "max_parallel_ralph_loops": 2,
    "max_parallel_mc_missions": 4,
    "rationale": "Provider default for claude — adjust via 'aiwg config set --project parallelism.max_parallel_subagents N'"
  }
}
